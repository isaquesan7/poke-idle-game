{
  "name": "kanto-idle-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo experimental de RPG idle baseado em dados da PokéAPI — Season 1 Kanto",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --check server.mjs && node --check scripts/pokemon-sprites.js && node --test tests/*.test.mjs",
    "sync:gifs": "node scripts/sync-pokemon-gifs.mjs",
    "verify:gifs": "node scripts/verify-pokemon-gifs.mjs",
    "test:core": "npm run test --workspace @kanto/game-core",
    "typecheck:core": "npm run typecheck --workspace @kanto/game-core",
    "dev:web": "npm run dev --workspace @kanto/web",
    "build:web": "npm run build --workspace @kanto/web",
    "test:web": "npm run test --workspace @kanto/web",
    "typecheck:web": "npm run typecheck --workspace @kanto/web"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
